{
  "name": "form-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Declarative form engine with Jekyll and Eleventy adapters",
  "type": "module",
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=60000 --test-concurrency=2 \"test/**/*.test.mjs\"",
    "validate": "node tools/validate-config.mjs",
    "check": "node tools/check.mjs",
    "verify-render": "powershell -File tools/verify-render.ps1 verify"
  },
  "keywords": [
    "form",
    "engine",
    "declarative",
    "jekyll",
    "eleventy",
    "11ty"
  ],
  "author": "Form Engine Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/realtyua/form-engine.git"
  },
  "bugs": {
    "url": "https://github.com/realtyua/form-engine/issues"
  },
  "homepage": "https://github.com/realtyua/form-engine#readme",
  "engines": {
    "node": ">=20"
  }
}